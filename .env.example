# Canonical env list — copy to .env.local and fill in real values.
# Never commit real keys. Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
# Server-only (private dataset read token). Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
